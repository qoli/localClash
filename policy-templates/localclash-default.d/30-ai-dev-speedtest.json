{
  "id": "default.ai-dev-speedtest.v1",
  "description": "Add ChatGPT, AI, large-model download, GitHub, and speed-test business groups.",
  "config": {
    "version": 3,
    "proxy_groups": {
      "ChatGPT-available": {
        "mode": "auto",
        "capability": "openai.chatgpt.statsig.v1",
        "smart_priority": [
          {
            "label": "US",
            "pattern": "(🇺🇸|美国|美國|(^|[^A-Za-z])US([^A-Za-z]|$)|United.?States|America)",
            "factor": 5
          },
          {
            "label": "JP",
            "pattern": "(🇯🇵|日本|(^|[^A-Za-z])JP([^A-Za-z]|$)|Japan)",
            "factor": 4
          },
          {
            "label": "SG",
            "pattern": "(🇸🇬|新加坡|狮城|獅城|(^|[^A-Za-z])SG([^A-Za-z]|$)|Singapore)",
            "factor": 3
          },
          {
            "label": "TW",
            "pattern": "(🇹🇼|台湾|台灣|(^|[^A-Za-z])TW([^A-Za-z]|$)|Taiwan)",
            "factor": 2
          },
          {
            "label": "Other",
            "pattern": ".*",
            "factor": 1
          }
        ],
        "optional": true,
        "reason": "由 localClash 在訂閱更新時透過 ab.chatgpt.com Statsig initialize 驗證線路可用性及服務觀察地區後重建。",
        "boundary": "chatgpt_service_qualified_subscription_nodes"
      }
    },
    "policy_groups": {
      "🤖 ChatGPT": {
        "mode": "manual",
        "exits": [
          "🇺🇸 美国节点",
          "🇯🇵 日本节点",
          "🇸🇬 新加坡节点",
          "🎯 手动选择",
          "⚡ 自动选择",
          "🇹🇼 台湾节点",
          "🇰🇷 韩国节点",
          "ChatGPT-available"
        ],
        "reason": "OpenAI/ChatGPT 專屬業務組；預設使用美國地區出口，將服務能力篩選出口放在最後供有需要的用戶手動選擇。",
        "boundary": "business_to_exit_layer"
      },
      "🧠 AI": {
        "mode": "manual",
        "exits": [
          "⚡ 自动选择",
          "🎯 手动选择",
          "🇸🇬 新加坡节点",
          "🇭🇰 香港节点",
          "🇺🇸 美国节点",
          "🇯🇵 日本节点",
          "🇹🇼 台湾节点",
          "🇰🇷 韩国节点",
          "🌐 全球直连"
        ],
        "reason": "非中国泛 AI 服务分类；OpenAI/ChatGPT 已由专属业务组先匹配。",
        "boundary": "business_to_exit_layer"
      },
      "📥 大模型下载": {
        "mode": "manual",
        "exits": [
          "🌐 全球直连",
          "⚡ 自动选择",
          "🇺🇸 美国节点",
          "🇭🇰 香港节点",
          "🇯🇵 日本节点",
          "🇸🇬 新加坡节点",
          "🇹🇼 台湾节点",
          "🇰🇷 韩国节点"
        ],
        "reason": "大模型制品传输默认走全球直连，保留自动选择及地区出口处理下载速度或可达性问题。",
        "boundary": "dedicated_model_artifact_delivery_hosts"
      },
      "💻 GitHub": {
        "mode": "manual",
        "exits": [
          "⚡ 自动选择",
          "🎯 手动选择",
          "🇭🇰 香港节点",
          "🇺🇸 美国节点",
          "🇯🇵 日本节点",
          "🇸🇬 新加坡节点",
          "🇹🇼 台湾节点",
          "🇰🇷 韩国节点",
          "🌐 全球直连"
        ],
        "reason": "GitHub 可根据本地网络质量选择代理或直连。",
        "boundary": "business_to_exit_layer"
      },
      "📊 测速服务": {
        "mode": "manual",
        "exits": [
          "🌐 全球直连",
          "🎯 手动选择",
          "⚡ 自动选择",
          "🇭🇰 香港节点",
          "🇺🇸 美国节点",
          "🇯🇵 日本节点",
          "🇸🇬 新加坡节点",
          "🇹🇼 台湾节点",
          "🇰🇷 韩国节点"
        ],
        "reason": "测速服务默认优先直连，便于对比直连和代理出口质量。",
        "boundary": "business_to_exit_layer"
      }
    },
    "custom_rules": [
      {
        "id": "large-model-download-hosts",
        "target": "📥 大模型下载",
        "reason": "Route dedicated Hugging Face and ModelScope artifact-transfer hosts plus the Ollama model registry without capturing their websites, generic cloud storage, or shared GitHub release assets.",
        "rules": [
          {
            "type": "domain",
            "value": "cas-server.xethub.hf.co"
          },
          {
            "type": "domain",
            "value": "cas-server.xethub-eu.hf.co"
          },
          {
            "type": "domain",
            "value": "transfer.xethub.hf.co"
          },
          {
            "type": "domain",
            "value": "transfer.xethub-eu.hf.co"
          },
          {
            "type": "domain",
            "value": "us.aws.cdn.hf.co"
          },
          {
            "type": "domain",
            "value": "us.gcp.cdn.hf.co"
          },
          {
            "type": "domain",
            "value": "cdn-lfs-us-1.hf.co"
          },
          {
            "type": "domain",
            "value": "cdn-lfs-eu-1.hf.co"
          },
          {
            "type": "domain",
            "value": "cdn-lfs-cn-1.modelscope.cn"
          },
          {
            "type": "domain",
            "value": "cdn-lfs-ap-1.modelscope.ai"
          },
          {
            "type": "domain",
            "value": "registry.ollama.ai"
          }
        ]
      }
    ],
    "packs": [
      {
        "source": "v2fly-dlc",
        "pack": "openai",
        "type": "geosite",
        "target": "🤖 ChatGPT",
        "reason": "Route OpenAI domains through ChatGPT selector."
      },
      {
        "source": "v2fly-dlc",
        "pack": "category-ai-!cn",
        "type": "geosite",
        "target": "🧠 AI",
        "reason": "Route non-China AI service categories through AI selector."
      },
      {
        "source": "v2fly-dlc",
        "pack": "github",
        "type": "geosite",
        "target": "💻 GitHub",
        "reason": "Route GitHub domains through GitHub selector."
      },
      {
        "source": "v2fly-dlc",
        "pack": "category-speedtest",
        "type": "geosite",
        "target": "📊 测速服务",
        "reason": "Route speed test domains through speed-test selector."
      }
    ]
  }
}
