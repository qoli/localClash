{
  "id": "default.region-exits.v1",
  "description": "Add direct and regional exit proxy groups.",
  "config": {
    "version": 3,
    "proxy_groups": {
      "🎯 手动选择": {
        "mode": "manual",
        "match": {
          "type": "name_regex",
          "pattern": ".*",
          "min": 1
        },
        "reason": "面向 Dashboard 的手动出口选择，包含全部订阅节点。",
        "boundary": "all_subscription_nodes"
      },
      "⚡ 自动选择": {
        "mode": "auto",
        "capability": "network.connectivity.g204.v1",
        "smart_priority": [
          {"label": "HK", "pattern": "(🇭🇰|香港|(^|[^A-Za-z])HK([^A-Za-z]|$)|Hong.?Kong)", "factor": 6},
          {"label": "JP", "pattern": "(🇯🇵|日本|(^|[^A-Za-z])JP([^A-Za-z]|$)|Japan)", "factor": 5},
          {"label": "SG", "pattern": "(🇸🇬|新加坡|狮城|獅城|(^|[^A-Za-z])SG([^A-Za-z]|$)|Singapore)", "factor": 4},
          {"label": "TW", "pattern": "(🇹🇼|台湾|台灣|(^|[^A-Za-z])TW([^A-Za-z]|$)|Taiwan)", "factor": 3},
          {"label": "US", "pattern": "(🇺🇸|美国|美國|(^|[^A-Za-z])US([^A-Za-z]|$)|United.?States|America)", "factor": 2},
          {"label": "Other", "pattern": ".*", "factor": 1}
        ],
        "reason": "面向 Dashboard 的免维护自动出口；订阅刷新时按实际入口排重并通过 generate_204 资格验证。",
        "boundary": "g204_qualified_unique_physical_endpoints"
      },
      "🇹🇼 台湾节点": {
        "mode": "auto",
        "match": {
          "type": "name_regex",
          "pattern": "(台湾|台灣|TW|Taiwan)"
        },
        "optional": true,
        "reason": "台湾地区出口组，按节点名称自动筛选。",
        "boundary": "name_based_region_selector"
      },
      "🇸🇬 新加坡节点": {
        "mode": "auto",
        "match": {
          "type": "name_regex",
          "pattern": "(狮城|獅城|新加坡|SG|Singapore)"
        },
        "optional": true,
        "reason": "新加坡地区出口组，按节点名称自动筛选。",
        "boundary": "name_based_region_selector"
      },
      "🇯🇵 日本节点": {
        "mode": "auto",
        "match": {
          "type": "name_regex",
          "pattern": "(日本|JP|Japan)"
        },
        "optional": true,
        "reason": "日本地区出口组，按节点名称自动筛选。",
        "boundary": "name_based_region_selector"
      },
      "🇺🇸 美国节点": {
        "mode": "auto",
        "match": {
          "type": "name_regex",
          "pattern": "(美国|美國|US|United.?States|America)"
        },
        "optional": true,
        "reason": "美国地区出口组，按节点名称自动筛选。",
        "boundary": "name_based_region_selector"
      },
      "🇰🇷 韩国节点": {
        "mode": "auto",
        "match": {
          "type": "name_regex",
          "pattern": "(韩国|韓國|KR|Korea)"
        },
        "optional": true,
        "reason": "韩国地区出口组，按节点名称自动筛选。",
        "boundary": "name_based_region_selector"
      },
      "🇭🇰 香港节点": {
        "mode": "auto",
        "match": {
          "type": "name_regex",
          "pattern": "(香港|HK|Hong.?Kong)"
        },
        "optional": true,
        "reason": "香港地区出口组，按节点名称自动筛选。",
        "boundary": "name_based_region_selector"
      }
    },
    "policy_groups": {
      "🌐 全球直连": {
        "mode": "manual",
        "exits": [
          "DIRECT",
          "⚡ 自动选择",
          "🇭🇰 香港节点",
          "🇺🇸 美国节点",
          "🇯🇵 日本节点",
          "🇸🇬 新加坡节点",
          "🇹🇼 台湾节点",
          "🇰🇷 韩国节点"
        ],
        "reason": "全局默认策略；默认直连，并允许临时切换到自动或地区代理出口。",
        "boundary": "global_default_to_exit_layer"
      },
      "DNSProxy": {
        "mode": "manual",
        "exits": [
          "⚡ 自动选择"
        ],
        "reason": "DNS 海外解析出口，默认对齐自动选择策略。",
        "boundary": "dns_proxy_exit"
      }
    }
  }
}
